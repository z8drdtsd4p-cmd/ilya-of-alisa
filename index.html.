<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>🎱 泰国斯诺克锦标赛</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                 "Microsoft YaHei", Arial, sans-serif;
    background: #07140e;
    color: #ffffff;
}

header {
    background: linear-gradient(135deg, #063d25, #0b6b3c);
    padding: 30px 20px;
    text-align: center;
    border-bottom: 2px solid #20c77a;
}

header h1 {
    margin: 0;
    font-size: 30px;
}

header p {
    margin: 8px 0 0;
    color: #c8f5dc;
    font-size: 14px;
}

nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 12px;
    background: #06110c;
    position: sticky;
    top: 0;
    z-index: 10;
}

nav button {
    border: 1px solid #1d754c;
    background: #0b2117;
    color: white;
    padding: 10px 14px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 14px;
}

nav button.active,
nav button:hover {
    background: #15945a;
}

.container {
    max-width: 1000px;
    margin: auto;
    padding: 25px 15px 50px;
}

.page {
    display: none;
}

.page.active {
    display: block;
}

.card {
    background: #0d2117;
    border: 1px solid #194d34;
    border-radius: 15px;
    padding: 20px;
    margin-bottom: 18px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.25);
}

.card h2 {
    margin-top: 0;
}

.stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 20px;
}

.stat {
    background: #0b2117;
    border: 1px solid #194d34;
    border-radius: 14px;
    padding: 18px;
    text-align: center;
}

.stat strong {
    display: block;
    font-size: 28px;
    color: #35d889;
}

.stat span {
    color: #a7cbb8;
    font-size: 13px;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th, td {
    padding: 13px 10px;
    border-bottom: 1px solid #214634;
    text-align: left;
}

th {
    color: #76e7aa;
}

.rank {
    font-weight: bold;
    width: 50px;
}

.points {
    color: #42dc8a;
    font-weight: bold;
}

.match {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
}

.player-name {
    font-size: 20px;
    font-weight: bold;
}

.score {
    font-size: 28px;
    font-weight: bold;
    color: #42dc8a;
    white-space: nowrap;
}

.small {
    color: #9db7a8;
    font-size: 13px;
    margin-top: 6px;
}

.players {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.player {
    background: #0b2117;
    border: 1px solid #194d34;
    border-radius: 14px;
    padding: 15px;
    display: flex;
    align-items: center;
    gap: 15px;
}

.photo {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #173c29;
    border: 2px solid #278957;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: #9dcab0;
    font-size: 11px;
    flex-shrink: 0;
}

.info-row {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #214634;
    padding: 14px 0;
}

.info-row:last-child {
    border-bottom: none;
}

.label {
    color: #9db7a8;
}

.value {
    font-weight: bold;
    text-align: right;
}

.notice {
    background: #123723;
    border-left: 4px solid #31d27f;
    padding: 14px;
    border-radius: 8px;
    color: #d9f7e5;
}

footer {
    text-align: center;
    color: #6f8d7d;
    padding: 25px;
    font-size: 12px;
}

@media (max-width: 650px) {
    header h1 {
        font-size: 24px;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    .players {
        grid-template-columns: 1fr;
    }

    .match {
        flex-direction: column;
        align-items: flex-start;
    }

    .score {
        align-self: center;
    }

    th, td {
        padding: 10px 6px;
        font-size: 13px;
    }
}
</style>
</head>

