    <div class="box">

        <h2>👤 参赛选手</h2>

        <div class="players">

            <div class="player">
                <div class="photo">照片<br>稍后完善</div>
                <b>ding</b>
            </div>

            <div class="player">
                <div class="photo">照片<br>稍后完善</div>
