            </div>

            <div class="player">
                <div class="photo">照片<br>稍后完善</div>
                <b>dehong</b>
            </div>

            <div class="player">
                <div class="photo">照片<br>稍后完善</div>
                <b>yunuo</b>
            </div>

            <div class="player">
                <div class="photo">照片<br>稍后完善</div>
                <b>Jk</b>
            </div>

            <div class="player">
                <div class="photo">照片<br>稍后完善</div>
                <b>alisa</b>
            </div>

            <div class="player">
                <div class="photo">照片<br>稍后完善</div>
                <b>haoxuan</b>
            </div>

            <div class="player">
                <div class="photo">照片<br>稍后完善</div>
                <b>Dank</b>
            </div>

            <div class="player">
                <div class="photo">照片<br>稍后完善</div>
                <b>wuyi</b>
            </div>

            <div class="player">
                <div class="photo">照片<br>稍后完善</div>
                <b>oli</b>
            </div>

        </div>

    </div>

</div>


<!-- 赛程 -->
<div id="schedule" class="page">

    <div class="box">

        <h2>📅 赛事赛程</h2>

        <div class="notice">
            暂无赛程
        </div>

    </div>

</div>


<!-- 赛事信息 -->
<div id="info" class="page">

    <div class="box">

        <h2>📋 赛事信息</h2>

        <div class="info">
            <span>赛事名称</span>
            <b>泰国芭提雅斯诺克锦标赛</b>
        </div>

        <div class="info">
            <span>英文名称</span>
            <b>Thailand Snooker Championship</b>
        </div>

        <div class="info">
            <span>比赛地点</span>
            <b>泰国芭提雅</b>
        </div>

        <div class="info">
            <span>比赛时间</span>
            <b>9月10日 - 9月29日</b>
        </div>

        <div class="info">
            <span>奖金</span>
            <b>50 泰铢</b>
        </div>

        <div class="info">
            <span>参赛人数</span>
            <b>10 人</b>
        </div>

    </div>

</div>

</main>

<footer>
    2026 Thailand Snooker Championship
</footer>


<script>

function page(id, button) {

    var pages = document.querySelectorAll(".page");

    for (var i = 0; i < pages.length; i++) {
        pages[i].classList.remove("active");
    }

    document.getElementById(id).classList.add("active");

    var buttons = document.querySelectorAll("nav button");

    for (var i = 0; i < buttons.length; i++) {
        buttons[i].classList.remove("active");
    }

    button.classList.add("active");

    window.scrollTo(0, 0);
}

</script>

</body>
</html>
