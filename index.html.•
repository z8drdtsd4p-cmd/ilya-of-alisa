<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>泰国斯诺克锦标赛</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #07130d;
    color: white;
    font-family: Arial, "Microsoft YaHei", sans-serif;
}

header {
    background: #0b5c35;
    text-align: center;
    padding: 28px 15px;
}

header h1 {
    margin: 0;
    font-size: 28px;
}

header p {
    margin: 8px 0 0;
    color: #c8ead7;
}

nav {
    background: #041009;
    padding: 10px;
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
    position: sticky;
    top: 0;
}

nav button {
    background: #12301f;
    color: white;
    border: 1px solid #28734b;
    padding: 10px 15px;
    border-radius: 8px;
    font-size: 14px;
}

nav button.active {
    background: #159452;
}

main {
    max-width: 900px;
    margin: auto;
    padding: 20px 15px 50px;
}

.page {
    display: none;
}

.page.active {
    display: block;
}

.box {
    background: #0d2116;
    border: 1px solid #1d4d33;
    border-radius: 12px;
    padding: 18px;
    margin-bottom: 16px;
}

h2 {
    margin-top: 0;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    padding: 12px 8px;
    border-bottom: 1px solid #254634;
    text-align: left;
}

th {
    color: #63dc99;
}

.points {
    color: #63dc99;
    font-weight: bold;
}

.match {
    text-align: center;
    padding: 25px 5px;
}

.players {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

.player {
    background: #10281a;
    border: 1px solid #24583b;
    border-radius: 10px;
    padding: 15px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.photo {
    width: 65px;
    height: 65px;
    background: #1a3d29;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 11px;
    color: #9ab8a5;
    flex-shrink: 0;
}

.info {
    display: flex;
    justify-content: space-between;
    padding: 13px 0;
    border-bottom: 1px solid #254634;
}

.green {
    color: #63dc99;
}

.big-score {
    font-size: 32px;
    font-weight: bold;
    color: #63dc99;
}

.notice {
    padding: 15px;
    background: #123b25;
    border-radius: 8px;
}

footer {
    text-align: center;
    color: #71877a;
    padding: 20px;
}

@media (max-width: 600px) {
    header h1 {
        font-size: 23px;
    }

    .players {
        grid-template-columns: 1fr;
    }

    th,
    td {
        font-size: 13px;
    }
}
</style>
</head>

<body>

<header>
    <h1>🎱 泰国斯诺克锦标赛</h1>
    <p>2026 Thailand Snooker Championship</p>
</header>

<nav>
    <button class="active" onclick="page('ranking', this)">🏆 排名</button>
    <button onclick="page('matches', this)">🎱 比赛</button>
    <button onclick="page('players', this)">👤 选手</button>
    <button onclick="page('schedule', this)">📅 赛程</button>
    <button onclick="page('info', this)">📋 赛事信息</button>
</nav>

<main>

<!-- 排名 -->
