<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>泰国斯诺克锦标赛</title>

<style>
* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: #06110d;
    color: #f5f7f6;
    font-family: Arial, "Microsoft YaHei", sans-serif;
}

/* 顶部 */
header {
    background: linear-gradient(135deg, #0b3927, #071b13);
    padding: 32px 20px;
    text-align: center;
    border-bottom: 1px solid #294538;
}

header h1 {
    margin: 0;
    font-size: 32px;
}

header p {
    margin: 10px 0 0;
    color: #aab8b2;
}

/* 导航 */
nav {
    background: #0a1712;
    padding: 14px;
    display: flex;
    justify-content: center;
    gap: 10px;
    border-bottom: 1px solid #23362e;
    position: sticky;
    top: 0;
    z-index: 100;
}

nav button {
    border: 1px solid #30463c;
    background: #101d18;
    color: #ddd;
    padding: 12px 20px;
    border-radius: 12px;
    cursor: pointer;
    font-size: 15px;
}

nav button:hover {
    background: #183328;
}

nav button.active {
    background: #d8b85b;
    color: #111;
    border-color: #d8b85b;
}

/* 页面 */
.container {
    max-width: 1100px;
    margin: auto;
    padding: 25px 18px 60px;
}

.page {
    display: none;
    animation: fadeIn .2s ease;
}

.page.active {
    display: block;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(5px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* 标题卡 */
.hero {
    background: #101d18;
    border: 1px solid #294038;
    border-radius: 20px;
    padding: 25px;
    margin-bottom: 20px;
}

.hero h2 {
    margin: 0 0 8px;
}

.hero p {
    margin: 0;
    color: #9eaaa5;
}

.status {
    display: inline-block;
    background: #d8b85b;
    color: #111;
    padding: 7px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 15px;
}

/* 数据 */
.stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-bottom: 20px;
}

.stat {
    background: #101d18;
    border: 1px solid #294038;
    border-radius: 18px;
    padding: 20px;
}

.stat-title {
    color: #9eaaa5;
    font-size: 14px;
    margin-bottom: 8px;
}

.stat-number {
    font-size: 28px;
    font-weight: bold;
}

/* 表格 */
.table-box {
    background: #101d18;
    border: 1px solid #294038;
    border-radius: 18px;
    overflow-x: auto;
}

table {
    width: 100%;
    min-width: 650px;
    border-collapse: collapse;
}

th {
    background: #0b1713;
    color: #9eaaa5;
    text-align: left;
    padding: 17px;
}

td {
    padding: 17px;
    border-top: 1px solid #293a34;
}

.points {
    color: #d8b85b;
    font-weight: bold;
}

/* 比赛 */
.match {
    background: #101d18;
    border: 1px solid #294038;
    border-radius: 20px;
    padding: 25px;
    margin-bottom: 15px;
    text-align: center;
}

.match-date {
    color: #9eaaa5;
    margin-bottom: 20px;
}

.match-players {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 30px;
    font-size: 24px;
    font-weight: bold;
}

.score {
    font-size: 34px;
    color: #d8b85b;
}

.big-score {
    margin-top: 15px;
    color: #aab5b0;
}

.big-score b {
    color: white;
}

/* 选手 */
.players-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
}

.player-card {
    background: #101d18;
    border: 1px solid #294038;
    border-radius: 18px;
    padding: 18px;
    display: flex;
    align-items: center;
    gap: 18px;
}

.player-photo {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, #214b3a, #14251f);
    border: 2px solid #3a594c;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    flex-shrink: 0;
}

.player-info h3 {
    margin: 0 0 8px;
    font-size: 20px;
}

.player-info p {
    margin: 4px 0;
    color: #9eaaa5;
    font-size: 14px;
}

.player-rank {
    color: #d8b85b !important;
}

/* 赛事信息 */
.info-card {
    background: #101d18;
    border: 1px solid #294038;
    border-radius: 20px;
    padding: 28px;
}

.info-card h2 {
    margin-top: 0;
}

.info-row {
    padding: 17px 0;
    border-bottom: 1px solid #293a34;
    display: flex;
    justify-content: space-between;
    gap: 20px;
}

.info-row:last-child {
    border-bottom: none;
}

.info-label {
    color: #9eaaa5;
}

.info-value {
    font-weight: bold;
    text-align: right;
}

/* 暂无 */
.empty {
    background: #101d18;
    border: 1px solid #294038;
    border-radius: 20px;
    padding: 50px 20px;
    text-align: center;
    color: #9eaaa5;
}

/* 手机 */
@media (max-width: 700px) {

    header h1 {
        font-size: 26px;
    }

    nav {
        justify-content: flex-start;
        overflow-x: auto;
    }

    nav button {
        flex-shrink: 0;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    .players-grid {
        grid-template-columns: 1fr;
    }

    .match-players {
        gap: 12px;
        font-size: 20px;
    }

    .score {
        font-size: 28px;
    }

    .info-row {
        flex-direction: column;
        gap: 6px;
    }

    .info-value {
        text-align: left;
    }
}
</style>
</head>


